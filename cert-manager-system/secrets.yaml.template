# netcup DNS API credentials for the cert-manager DNS-01 webhook.
# Copy to secrets.yaml (gitignored), fill in, then: kubectl apply -f secrets.yaml
#
# The webhook picks the API automatically from the keys present:
#
# netcup REST API (api.netcup.com), new DNS backend.
# Create the API key in the netcup admin panel (Administration > REST-API),
apiVersion: v1
kind: Secret
metadata:
  name: netcup-api-credentials
  namespace: cert-manager-system
type: Opaque
stringData:
  api-key: "<rest-api-key-from-netcup>"
