apiVersion: v1
kind: Secret
metadata:
  name: open-webui-secrets
  namespace: ai
type: Opaque
stringData:
  # JWT signing key. Without it Open WebUI generates a random key on every pod start
  # (stored in /app/backend/.webui_secret_key on the container filesystem), which logs out
  # every session after each deploy and makes a browser token from before the restart 401.
  # openssl rand -hex 32
  WEBUI_SECRET_KEY: "<long-random-value>"
  # Pocket ID OIDC client: Administration -> OIDC Clients -> "Open WebUI"
  # callback URL of the client must be https://open-webui.stephanme.de/oauth/oidc/callback
  OAUTH_CLIENT_ID: "<client-id>"
  OAUTH_CLIENT_SECRET: "<client-secret>"
