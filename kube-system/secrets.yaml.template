---
# Pocket ID OIDC client for the Kubernetes API (see README.md).
# Copy to secrets.yaml (gitignored) and fill in the values from the Pocket ID client page.
apiVersion: v1
kind: Secret
metadata:
  name: k3s-oidc-client
  namespace: kube-system
type: Opaque
stringData:
  # Pocket ID: Administration -> OIDC Clients -> "Kubernetes API (k3s)".
  # The client id is also the value of oidc-client-id in /etc/rancher/k3s/config.yaml on
  # every server node: kube-apiserver and Headlamp must use the same client, otherwise the
  # api server rejects Headlamp's token with an audience mismatch.
  client_id: "<client id>"
  # shown once when the client is created
  client_secret: "<client secret>"
